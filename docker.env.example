# Sao chép thành file `.env` tại thư mục gốc repo (cùng cấp docker-compose.yml)
# để docker compose thay thế biến khi BUILD frontend. Không commit file `.env` thật.

REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_thay_bang_key_cua_ban
REACT_APP_STRIPE_TESTING_ASSISTANT=false

# Tuỳ chọn — ghi đè CORS cho backend (mặc định đã gồm localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
